{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "social-share",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*"]
  },
  "routes": [
    {
      "pattern": "social-share.mazaryk.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
